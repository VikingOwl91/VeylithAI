#!/bin/sh
# Fail closed on environment drift, then run the Veylith training CLI.
set -eu

SELF=$(readlink -f "$0")
HERE=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
REPO=$(CDPATH= cd -- "$HERE/../../.." && pwd)
ENV_DIR="${VEYLITH_ENV_DIR:-$HOME/veylith-v31-isolated}"
FINGERPRINT="$ENV_DIR/env.fingerprint.json"

"$HERE/veylith-python" "$HERE/env_check.py" \
    --expected "$HERE/env.baseline.json" \
    --lock "$HERE/requirements.lock" \
    --json "$FINGERPRINT" \
    --strict-host

export VEYLITH_ENV_FINGERPRINT="$FINGERPRINT"
exec "$HERE/veylith-python" "$REPO/veylith/v3/train_v31.py" "$@"
